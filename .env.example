# ── Backend URL ───────────────────────────────────────────────
# fusion-rag backend, including the /api/v1 prefix
VITE_BACKEND_URL=http://localhost:8001/api/v1

# ── Sibling auth frontend (login/logout redirects) ────────────
VITE_AUTH_FRONTEND_URL=http://localhost:8085

# ── Uploads ───────────────────────────────────────────────────
# Max file size accepted by the file picker, in MB
VITE_MAX_UPLOAD_MB=1024

# ── Dev tools ─────────────────────────────────────────────────
VITE_ENABLE_REACT_SCAN=false

# ── Mode ──────────────────────────────────────────────────────
VITE_NODE_ENV=development
